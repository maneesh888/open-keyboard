# Copy this file to <primary-checkout>/.agent/local-seeds/openkeyboard-gateway.env.
# Linked worktrees read that per-machine file directly and never receive a copy.
# Never commit the real seed file. .agent/local-seeds/ is ignored.
# Keep the trusted directory current-user-owned, without extended ACL entries,
# and not writable by group or other users
# (for example: chmod 700 <primary-checkout>/.agent/local-seeds).
# Restrict the real file after creating it: chmod 600 <primary-checkout>/.agent/local-seeds/openkeyboard-gateway.env
# Every configured profile must include its URL, API key, and exact model ID.
# The targeted differential matrix requires both LOW and HIGH. Values may point
# to the same gateway, but each role remains explicit and is never substituted.

OPEN_KEYBOARD_SIMULATOR_LOW_GATEWAY_URL=https://your-low-profile-gateway.example
OPEN_KEYBOARD_SIMULATOR_LOW_API_KEY=replace-with-low-profile-key-locally
OPEN_KEYBOARD_SIMULATOR_LOW_MODEL=your-low-capability-model-id

OPEN_KEYBOARD_SIMULATOR_HIGH_GATEWAY_URL=https://your-high-profile-gateway.example
OPEN_KEYBOARD_SIMULATOR_HIGH_API_KEY=replace-with-high-profile-key-locally
OPEN_KEYBOARD_SIMULATOR_HIGH_MODEL=your-high-capability-model-id

# Backward-compatible single-profile fallback for ordinary live verification.
# Use this complete triple only when LOW/HIGH differential testing is not needed.
# OPEN_KEYBOARD_SIMULATOR_GATEWAY_URL=https://your-gateway.example
# OPEN_KEYBOARD_SIMULATOR_API_KEY=replace-with-real-key-locally
# OPEN_KEYBOARD_SIMULATOR_MODEL=your-reference-model-id
