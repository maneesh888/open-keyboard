#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PUSH_REFS_FILE="$(mktemp)"
trap 'rm -f "$PUSH_REFS_FILE"' EXIT
cat > "$PUSH_REFS_FILE"

require_clean_tree() {
  if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ]]; then
    echo "Refusing to push from a dirty worktree." >&2
    git -C "$ROOT" status --short >&2
    exit 1
  fi
}

require_pushed_refs_match_head() {
  local head_oid
  head_oid="$(git -C "$ROOT" rev-parse HEAD)"

  while read -r local_ref local_oid _remote_ref _remote_oid; do
    case "$local_ref" in
      refs/heads/*)
        if [[ "$local_oid" != "$head_oid" ]]; then
          echo "Refusing to push a branch that is not checked-out HEAD." >&2
          exit 1
        fi
        ;;
      refs/tags/*)
        if [[ "$(git -C "$ROOT" rev-list -n 1 "$local_oid")" != "$head_oid" ]]; then
          echo "Refusing to push a tag that does not resolve to checked-out HEAD." >&2
          exit 1
        fi
        ;;
    esac
  done
}

require_clean_tree
require_pushed_refs_match_head < "$PUSH_REFS_FILE"

echo "Running OpenKeyboard pre-push checks..."
env \
  -u OPEN_KEYBOARD_LIVE_GATEWAY_URL \
  -u OPEN_KEYBOARD_LIVE_API_KEY \
  -u OPEN_KEYBOARD_LIVE_MODEL \
  -u OPEN_KEYBOARD_TEST_GATEWAY_URL \
  -u OPEN_KEYBOARD_TEST_API_KEY \
  -u OPEN_KEYBOARD_TEST_MODEL \
  -u OPEN_KEYBOARD_LIVE_EXPECTED_SHA \
  "$ROOT/scripts/check.sh" --full
require_clean_tree

LIVE_BASE_REF="${OPEN_KEYBOARD_LIVE_BASE_REF:-origin/main}"
LIVE_BASE_SHA="$(git -C "$ROOT" rev-parse --verify "$LIVE_BASE_REF^{commit}" 2>/dev/null)" || {
  echo "Live-impact classification could not resolve $LIVE_BASE_REF." >&2
  echo "Fetch the base branch or set OPEN_KEYBOARD_LIVE_BASE_REF." >&2
  exit 1
}
HEAD_SHA="$(git -C "$ROOT" rev-parse --verify HEAD)"
LIVE_IMPACT="$("$ROOT/scripts/live-impact.sh" "$LIVE_BASE_SHA" "$HEAD_SHA")"

case "$LIVE_IMPACT" in
  none)
    ;;
  gateway)
    echo "Gateway-impacting changes require exact-head local live verification."
    OPEN_KEYBOARD_LIVE_EXPECTED_SHA="$HEAD_SHA" \
      "$ROOT/scripts/check-live.sh" gateway
    ;;
  *)
    echo "Live-impact classification returned an invalid result." >&2
    exit 1
    ;;
esac

require_clean_tree
