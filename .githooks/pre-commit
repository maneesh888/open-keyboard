#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if ! git -C "$ROOT" diff --quiet --; then
  echo "Refusing to commit with unstaged tracked changes." >&2
  echo "Stage or revert them so checks match the exact commit." >&2
  git -C "$ROOT" status --short >&2
  exit 1
fi

if [[ -n "$(git -C "$ROOT" ls-files --others --exclude-standard)" ]]; then
  echo "Refusing to commit with untracked files." >&2
  echo "Stage or remove them so checks match the exact commit." >&2
  git -C "$ROOT" status --short >&2
  exit 1
fi

TECHNICAL_IMPACT="$("$ROOT/scripts/technical-impact.sh" --staged)"

echo "Running OpenKeyboard deterministic pre-commit checks ($TECHNICAL_IMPACT)..."
echo "Evidence boundary: this hook can establish DETERMINISTIC_VERIFIED only; it does not grant commit authority or establish LIVE_VERIFIED or RUNTIME_VERIFIED."
case "$TECHNICAL_IMPACT" in
  docs-only)
    "$ROOT/scripts/check.sh" --hygiene
    ;;
  full)
    "$ROOT/scripts/check.sh" --quick
    ;;
  *)
    echo "Technical-impact classification returned an invalid result." >&2
    exit 1
    ;;
esac
